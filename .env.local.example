# --- Supabase (database, auth) ---
# From Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic Claude (OCR, classification, field extraction) ---
# From console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# --- Storage backend ---
# Which storage adapter to use as the default. Currently only 'dropbox' is implemented.
# Future values: 'gdrive', 'onedrive', 's3', 'local'.
DEFAULT_STORAGE_PROVIDER=dropbox

# --- Dropbox (file storage) ---
# From dropbox.com/developers/apps -> your app -> Settings tab
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Generated access token (no expiration) -> paste here
DROPBOX_ACCESS_TOKEN=
# Folder inside your Dropbox where documents will be stored
DROPBOX_ROOT_FOLDER=/Archive

# --- App URL (used for OAuth callbacks, share links) ---
# Locally: http://localhost:3002  |  Production: https://your-vercel-domain.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3002
